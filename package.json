{
  "name": "trip-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-global-webcrypto vite",
    "build": "tsc -b && NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "NODE_OPTIONS=--experimental-global-webcrypto vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.{json,js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"*.{json,js,ts}\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@supabase/supabase-js": "2.49.8",
    "@tanstack/react-query": "5.66.8",
    "dexie": "4.0.11",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.5.1",
    "prettier": "3.8.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
