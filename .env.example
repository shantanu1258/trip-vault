# Browser-safe Supabase configuration. Leave unset to run the bundled demo only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Turn on only after the push migration and Edge Functions have been deployed.
VITE_PUSH_ENABLED=false
# Optional override of the browser-safe VAPID public key bundled for this app.
VITE_VAPID_PUBLIC_KEY=
